TSW_IMAGE=ghcr.io/gucooing/apophis-teamseatwatch:v1.0.0
COMPOSE_PROJECT_NAME=teamseatwatch

# Exact admin origin as seen in the browser, without /owner/ or a trailing slash.
# For a reverse proxy, use e.g. https://admin.example.com.
TSW_OWNER_ORIGINS=http://localhost:18443,http://127.0.0.1:18443
TSW_BIND_ADDRESS=127.0.0.1
TSW_OWNER_PORT=18443
TSW_REDEEM_PORT=18444

# Web requests use the installed Chromium's UA unless explicitly configured.
TSW_CLIENT_USER_AGENT=
TSW_CLIENT_ACCEPT_LANGUAGE=en-US,en;q=0.9
TSW_CLIENT_TIMEZONE=UTC
# Optional actual web client metadata; empty values are omitted from requests.
TSW_CLIENT_WEB_VERSION=
TSW_CLIENT_WEB_BUILD=
# Codex OAuth/token/usage traffic keeps a Codex UA and protocol.
TSW_CLIENT_CODEX_USER_AGENT=codex_cli_rs/0.146.0
